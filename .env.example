# Local path overrides. Heavyweight gitignored stores live in `.notongit/NeuroGolf_nogit/`
# INSIDE the repo (moved there 2026-08-17 from the old sibling `Py_cx\.notongit\`); the
# project tree carries Windows directory junctions to them, so these env vars are OPTIONAL
# on the owner's machine (code's default fallbacks resolve through the junctions). Set them
# when running from a different machine, a worktree where junctions are missing, or to
# override the layout.
#
# Canonical layout:
#   NEUROGOLF_MAIN_ROOT       = the K-NeuroGolf repo checkout
#   NEUROGOLF_NOGIT_ROOT      = <repo>/.notongit/NeuroGolf_nogit — data + venv + submissions archive
# All other vars default to paths under NEUROGOLF_NOGIT_ROOT.

NEUROGOLF_MAIN_ROOT=C:\path\to\K-NeuroGolf
NEUROGOLF_NOGIT_ROOT=C:\path\to\K-NeuroGolf\.notongit\NeuroGolf_nogit
NEUROGOLF_DATA_DIR=C:\path\to\K-NeuroGolf\.notongit\NeuroGolf_nogit\data\competitions\neurogolf-2026
NEUROGOLF_PYTHON=C:\path\to\K-NeuroGolf\.notongit\NeuroGolf_nogit\.venv\Scripts\python.exe
NEUROGOLF_COMPETITOR_ARTIFACTS_DIR=C:\path\to\K-NeuroGolf\.notongit\NeuroGolf_nogit\data\competitor_artifacts
# ng_gate shared test harness corpus cache (separate drive, NOT a junction). See WHERE_DATA_LIVES.md.
NEUROGOLF_ARGEN_CACHE=Q:\AIz\BoBrain\Data\domains\neurogolf\argen_cache
# Optional: cap concurrent ng_gate throttle slots dir (default %TEMP%\ng_throttle)
NEUROGOLF_THROTTLE_DIR=
# Optional: auto-open one visible read-only ng_gate queue watcher on future ng_gate runs.
# You can also pass --watch-queue to a single ng_gate invocation instead.
NEUROGOLF_GATE_WATCH=
NEUROGOLF_GATE_WATCH_INTERVAL=5
# Optional: force the auto watcher to use a terminal instead of the solid Tk window.
NEUROGOLF_GATE_WATCH_TERMINAL=
ARC_GEN_DIR=
KAGGLE_CONFIG_DIR=

# Secrets: set these in your shell/User env or an ignored .env, never in tracked files.
ANTHROPIC_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
