# Codex-lane background launcher (PowerShell). Generated by prep_run.py.
# Starts launch.ps1 hidden + detached so the Supervisor session is not blocked; records pid.txt for targeted reap.
$ErrorActionPreference = "Stop"

Set-Location -LiteralPath "{{REPO}}"

$runDir = "Agenters\Orchestrator\runs\{{RUN_ID}}"
$launch = Join-Path (Get-Location) "$runDir\launch.ps1"
$process = Start-Process -FilePath "powershell.exe" `
  -ArgumentList @("-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $launch) `
  -WindowStyle Hidden `
  -PassThru

$process.Id | Set-Content -LiteralPath "$runDir\pid.txt"
"launched $(Get-Date -Format o)" | Set-Content -LiteralPath "$runDir\launched.txt"
