# Codex-lane Orchestrator launch (PowerShell). Generated by prep_run.py.
# Model: pin gpt-5.5 + xhigh/extra-high effort; service_tier=priority requests the fast tier on CLIs that expose it.
# Sandbox: -s danger-full-access is the recorded Windows Codex fallback (Supervisor README s.Launch standing rules).
$ErrorActionPreference = "Stop"
if (Test-Path variable:PSNativeCommandUseErrorActionPreference) {
  $PSNativeCommandUseErrorActionPreference = $false
}

Set-Location -LiteralPath "{{REPO}}"

$runDir = "Agenters\Orchestrator\runs\{{RUN_ID}}"
$promptPath = "$runDir\launch_packet.md"
$prompt = Get-Content -LiteralPath $promptPath -Raw

New-Item -ItemType Directory -Path "$runDir\children" -Force | Out-Null
"started $(Get-Date -Format o)" | Set-Content -LiteralPath "$runDir\started.txt"

$exitCode = 999
try {
  $previousErrorActionPreference = $ErrorActionPreference
  $ErrorActionPreference = "Continue"
  $prompt | & codex -a never exec `
    -C "{{REPO}}" `
    -m gpt-5.5 `
    -c 'model_reasoning_effort="xhigh"' `
    -c 'service_tier="priority"' `
    -s danger-full-access `
    --json `
    -o "$runDir\orchestrator_final.md" `
    - `
    1> "$runDir\orchestrator_events.jsonl" `
    2> "$runDir\orchestrator_err.txt"

  $exitCode = $LASTEXITCODE
  $ErrorActionPreference = $previousErrorActionPreference
}
catch {
  $ErrorActionPreference = "Continue"
  $_ | Out-String | Add-Content -LiteralPath "$runDir\orchestrator_err.txt"
}
finally {
  $exitCode | Set-Content -LiteralPath "$runDir\exit_code.txt"
  "ended $(Get-Date -Format o)" | Set-Content -LiteralPath "$runDir\ended.txt"
}
