# Claude-lane Orchestrator launch (bash / git-bash). Generated by prep_run.py.
# Auth: force subscription with `env -u ANTHROPIC_API_KEY` (never the API key - it hard-fails on low balance).
# Model: pin --model (default never flips to Fable); this governs ONLY the coordination loop, not spawned subagents.
# BG ceiling: CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 = wait indefinitely for in-flight workers instead of dying at the
#   600s default mid-wave (alpha_p45 died 4/20 at the ceiling; p45b with =0 ran all 10 to terminal and self-closed clean).
env -u ANTHROPIC_API_KEY CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 claude -p "$(cat Agenters/Orchestrator/runs/{{RUN_ID}}/launch_packet.md)" \
  --model {{ORCH_MODEL}} \
  --output-format json \
  --dangerously-skip-permissions \
  < /dev/null > Agenters/Orchestrator/runs/{{RUN_ID}}/out.json 2>&1
